{
  // 纯逻辑模块的类型检查 (tsc --checkJS): lyrics-parser / player-queue /
  // downloads / cellular-usage (音乐, 在 js/ 子目录)。页面脚本 (music-*.js)
  // 依赖播放器 DOM 宿主, 类型声明成本高, 由 ESLint 把关。
  // types:[] — 不自动引入 node_modules/@types (共享目录里有别的包声明)
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2020",
    "lib": ["dom", "es2020"],
    "types": []
  },
  "include": [
    "app/music/static/js/lyrics-parser.js",
    "app/music/static/js/player-queue.js",
    "app/music/static/js/downloads.js",
    "app/music/static/js/downloads-capability.js",
    "app/music/static/js/cellular-usage.js",
    "frontend-globals.d.ts"
  ]
}
