# 复制为 .env 并填写; .env 已被 git 忽略
# 首启种子管理员的账密 (种过之后走界面改; 不设 AUTH_PASS 则首启不种
# 管理员, 无法登录 —— 仓库是公开的, 不带默认口令)
AUTH_USER=admin
AUTH_PASS=

# 可选: 服务端口
# PORT=8500

# 可选: 曲库 SQLite 与音乐目录 (默认 data/music.db 与 /share/Media/Music,
# 目录也可以进应用后在 设置 页里改)。MYTESLA_MUSIC_DB 要写完整 URL
# (引擎在 app/music 包里, 只认 URL 形式)
# MYTESLA_MUSIC_DB=sqlite:///data/music.db
# MYTESLA_MUSIC_DIR=/share/Media/Music

# 可选: 账号库与会话密钥 (My Home 组合部署时由外层指到共享文件,
# 独立部署默认在仓内; 裸路径相对仓根, 账号库也可写完整 sqlite:///… URL)
# MYHOME_USERS_DB=data/users.db
# MYHOME_SECRET_FILE=.session_secret
